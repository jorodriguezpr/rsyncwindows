# Build output under src/test/tools ONLY -- dist/bin holds the intentionally-tracked published
# binaries, so these patterns are scoped (a bare "bin/"/"obj/" would also match dist/bin).
src/**/[Bb]in/
src/**/[Oo]bj/
test/**/[Bb]in/
test/**/[Oo]bj/
tools/**/[Bb]in/
tools/**/[Oo]bj/
TestResults/
*.user

# IDE
.vs/
.vscode/
*.suo

# OS cruft
Thumbs.db
.DS_Store

# Local scratch
*.tmp
*.log
