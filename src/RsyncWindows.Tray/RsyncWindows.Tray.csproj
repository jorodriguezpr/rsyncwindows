<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RsyncWindows.Core\RsyncWindows.Core.csproj" />
    <ProjectReference Include="..\RsyncWindows.Transports\RsyncWindows.Transports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\rsyncWindows.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Authors>Jose Rodriguez Arroyo</Authors>
    <Company>Jose Rodriguez Arroyo</Company>
    <Product>rsyncWindows</Product>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\rsyncWindows.ico" Link="rsyncWindows.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>